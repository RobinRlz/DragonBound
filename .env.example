WEB_PORT=80

# Genera valores aleatorios, por ejemplo:  openssl rand -hex 32
COOKIE_SECRET=cambia-esto
SESSION_SECRET=cambia-esto

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=cambia-esto
DB_DATABASE=dragonbound
DB_PORT=3306

# Opcional: correo para "olvidé mi contraseña" (si se deja vacío, no se envía nada)
SMTP_USER=
SMTP_PASS=

# Ids de cuenta (IdAcc) con acceso al panel /admin además de las de rango 31. Ejemplo: 634,12
ADMIN_USER_IDS=

# Móvil favorito: estas cuentas (IdAcc) reciben siempre uno de estos móviles al elegir "Random".
# 8 = Knight (unicornio), 10 = Barney (dragón morado). Vacío = sin efecto.
FAVORITE_MOBILE_USER_IDS=
FAVORITE_MOBILES=8,10
